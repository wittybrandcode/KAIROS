{
  "name": "kairos-design-system",
  "version": "1.0.0",
  "description": "Design system for broadcast control surfaces — hard edges, cool steel, broadcast precision.",
  "main": "dist/kairos.umd.js",
  "module": "dist/kairos.mjs",
  "style": "dist/kairos.min.css",
  "exports": {
    ".": {
      "import": "./dist/kairos.mjs",
      "require": "./dist/kairos.umd.js",
      "style": "./dist/kairos.min.css"
    },
    "./kairos.min.css": "./dist/kairos.min.css"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:icons && vite build && npm run build:patterns",
    "build:icons": "node scripts/build-icons.js",
    "build:showcase": "vite build calibration",
    "build:patterns": "node scripts/build-patterns.js",
    "lint": "stylelint \"src/**/*.css\"",
    "lint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:smoke": "node scripts/test-smoke.js",
    "update-patterns": "node scripts/update-patterns.js"
  },
  "keywords": [
    "design-system",
    "broadcast",
    "css",
    "ui",
    "kairos"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@vitejs/plugin-react": "^6.0.2",
    "browserslist": "^4.28.2",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stylelint": "^16.0.0",
    "stylelint-order": "^6.0.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
